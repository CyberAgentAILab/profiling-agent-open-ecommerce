# Copy this file to .env and set only the values you need.
# .env is loaded automatically at startup (python-dotenv). Every variable is optional.

# --- Web search (src/search) ---
# No API key is required by default: when SERPER_API_TOKEN is unset (or empty),
# the search stage falls back to the free ddgs (DuckDuckGo) scraper.
# To reproduce the paper's results, set a Serper API token (https://serper.dev).
# It is used when `search_engine: serper` in the search task_config.yaml (the default).
# SERPER_API_TOKEN=""

# Alternative backend: SearchApi (https://www.searchapi.io).
# Used only when `search_engine: serp` in the search task_config.yaml.
# SERP_API_TOKEN=""
